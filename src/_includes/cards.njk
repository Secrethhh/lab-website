<div class="cards">{% for item in items %}<article class="card"><div class="meta">{{ item.data.year }} / {{ item.data.venue }} <span>{{ item.data.status }}</span></div><h3><a href="{{ item.url | relative(page.url) }}">{{ item.data.title }}</a></h3><p>{{ item.data.summary }}</p><div class="links"><a href="{{ item.url | relative(page.url) }}">研究详情 ↗</a>{% if item.data.code %}<a href="{{ item.data.code }}">代码 ↗</a>{% endif %}{% if item.data.data %}<a href="{{ item.data.data }}">数据集 ↗</a>{% endif %}</div></article>{% endfor %}</div>