<div class="paper-list">{% for item in items %}<article class="paper-row"><div class="paper-visual">{% if item.data.figure %}<a class="paper-figure" href="{{ item.data.figure | relative(page.url) }}" aria-label="View research figure"><img src="{{ item.data.figure | relative(page.url) }}" alt="{{ item.data.figureAlt }}" loading="lazy" decoding="async"><span class="venue-ribbon">{{ item.data.venue }} {{ item.data.year }}</span></a>{% else %}<div class="paper-figure figure-pending"><span class="venue-ribbon">{{ item.data.venue }} {{ item.data.year }}</span> <span>Figure coming soon</span></div>{% endif %}</div><div class="paper-copy" lang="en"><p class="paper-citation" data-paper="{{ item.page.fileSlug }}">{% if item.data.paper %}<a class="paper-title" href="{{ item.data.paper }}">{{ item.data.title }}</a>{% else %}<span class="paper-title">{{ item.data.title }}</span>{% endif %} {% if item.data.authors %}{{ item.data.authors }}. {% endif %}<strong>{{ item.data.venue }} {{ item.data.year }}.</strong>{% if item.data.status == 'Accepted' %} <span class="publication-status">Accepted.</span>{% elif item.data.status == 'Preprint' %} <span class="publication-status">Preprint.</span>{% endif %}</p><ul class="paper-notes"><li>{{ item.data.summary }}</li>{% if item.data.code or item.data.data %}<li class="paper-actions">{% if item.data.code %} <a class="resource-badge code-badge" href="{{ item.data.code }}"><span>Code</span> <span>GitHub</span></a>{% endif %}{% if item.data.data %}{% if item.data.code %} <span class="link-separator" aria-hidden="true">&nbsp;|&nbsp;</span> {% endif %} <a class="resource-badge data-badge" href="{{ item.data.data }}"><span>Dataset</span> <span>Access</span></a>{% endif %}</li>{% endif %}</ul></div></article>{% endfor %}</div>
