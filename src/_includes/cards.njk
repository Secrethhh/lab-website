<div class="paper-list">{% for item in items %}<article class="paper-row"><div class="paper-meta"><strong>{{ item.data.year }}</strong><span>{{ item.data.venue }}</span><span class="badge">{{ item.data.status }}</span></div><div><h3><a href="{{ item.url | relative(page.url) }}">{{ item.data.title }}</a></h3>{% if item.data.authors %}<p class="authors">{{ item.data.authors }}</p>{% endif %}<p>{{ item.data.summary }}</p><div class="links"><a href="{{ item.url | relative(page.url) }}">研究详情 ↗</a>{% if item.data.paper %}<a href="{{ item.data.paper }}">论文 ↗</a>{% endif %}{% if item.data.code %}<a href="{{ item.data.code }}">代码 ↗</a>{% endif %}{% if item.data.data %}<a href="{{ item.data.data }}">数据集 ↗</a>{% endif %}</div></div></article>{% endfor %}</div>