<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ description or site.intro }}"><title>{% if page.url == '/' %}MMSLAB{% else %}{{ title }} · MMSLAB{% endif %}</title><link rel="stylesheet" href="{{ '/assets/academic.css' | relative(page.url) }}?v=20261010-sticky"></head>
<body><a class="skip" href="#main">跳至正文</a>
<header class="masthead"><div class="masthead-inner"><a class="brand" href="{{ '/' | relative(page.url) }}">MMSLAB</a><nav aria-label="主导航">{% for label,url in [['首页','/'],['News','/#news'],['研究方向','/#directions'],['近期重点成果','/#publications'],['论文成果','/publications/'],['开放资源','/#resources']] %}<a {% if page.url == url or (url != '/' and url in page.url) %}aria-current="page"{% endif %} href="{% if page.url == '/' and '#' in url %}{{ url | replace('/', '') }}{% else %}{{ url | relative(page.url) }}{% endif %}">{{ label }}</a>{% endfor %}</nav><a class="language" href="{{ ('/en' + page.url) | relative(page.url) }}" lang="en" hreflang="en" aria-label="Switch to English">English ↗</a></div></header>
<script>
// Measure navigation height when its items wrap or the viewport changes.
const masthead = document.querySelector(".masthead");
const updateHeaderHeight = () => document.documentElement.style.setProperty("--masthead-height", `${masthead.getBoundingClientRect().height}px`);
updateHeaderHeight();
if (window.ResizeObserver) new ResizeObserver(updateHeaderHeight).observe(masthead);
else window.addEventListener("resize", updateHeaderHeight);
</script>
<div class="site-shell{% if page.url == '/people/ren-yanzhen/' %} profile-layout{% endif %}"><aside class="lab-sidebar"><a class="lab-emblem" href="{{ '/' | relative(page.url) }}" aria-label="MMSLAB"><img src="{{ '/assets/mmslab-logo.png' | relative(page.url) }}" alt="MMSLAB" width="336" height="249" decoding="async"></a><p class="sidebar-name">MMSLAB 多媒体安全实验室</p><p class="sidebar-institution">{{ site.institution }}</p><p class="sidebar-description">多媒体安全 · 信息隐藏</p><ul class="sidebar-links"><li><span aria-hidden="true">⌖</span> 武汉，中国</li><li><a href="mailto:renyz@whu.edu.cn">✉ renyz@whu.edu.cn</a></li></ul></aside><main id="main">{{ content | safe }}</main></div>
</body></html>
