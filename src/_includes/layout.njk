<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ description or site.intro }}"><title>{{ title }} · Lab</title><link rel="stylesheet" href="{{ '/assets/academic.css' | relative(page.url) }}"></head>
<body><a class="skip" href="#main">跳至正文</a><header><a class="brand" href="{{ '/' | relative(page.url) }}"><span class="wordmark"><b>Lab</b></span><span class="brand-name">Lab 多媒体安全<small>{{ site.institution }}</small></span></a><a class="language" href="{{ ('/en' + page.url) | relative(page.url) }}" lang="en" hreflang="en" aria-label="Switch to English">English ↗</a><nav aria-label="主导航">{% for label,url in [['首页','/'],['团队介绍','/about/'],['研究方向','/research/'],['论文成果','/publications/'],['开放资源','/resources/'],['任延珍老师','/people/ren-yanzhen/']] %}<a {% if page.url == url or (url != '/' and url in page.url) %}aria-current="page"{% endif %} href="{{ url | relative(page.url) }}">{{ label }}</a>{% endfor %}</nav></header><main id="main">{{ content | safe }}</main><footer><div><strong>Lab 多媒体安全</strong><p>{{ site.institution }}</p><p>多媒体安全 · 信息隐藏</p></div><div><a href="{{ '/people/ren-yanzhen/' | relative(page.url) }}">联系与交流</a><p><span>资料更新：</span>{{ site.updated }}</p><a href="https://github.com/Secrethhh/lab-website">网站源码与维护说明</a></div></footer></body></html>