<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ description or site.intro }}"><title>{{ title }} · MMSLAB</title><link rel="stylesheet" href="{{ '/assets/academic.css' | relative(page.url) }}"></head>
<body><a class="skip" href="#main">跳至正文</a>
<header class="masthead"><div class="masthead-inner"><a class="brand" href="{{ '/' | relative(page.url) }}">MMSLAB</a><nav aria-label="主导航">{% for label,url in [['首页','/'],['团队介绍','/about/'],['研究方向','/research/'],['论文成果','/publications/'],['开放资源','/resources/'],['任延珍老师','/people/ren-yanzhen/']] %}<a {% if page.url == url or (url != '/' and url in page.url) %}aria-current="page"{% endif %} href="{{ url | relative(page.url) }}">{{ label }}</a>{% endfor %}</nav><a class="language" href="{{ ('/en' + page.url) | relative(page.url) }}" lang="en" hreflang="en" aria-label="Switch to English">English ↗</a></div></header>
<div class="site-shell"><aside class="lab-sidebar"><a class="lab-emblem" href="{{ '/' | relative(page.url) }}" aria-label="MMSLAB"><span>MM<span class="emblem-light">S</span></span><small>LAB</small></a><p class="sidebar-name">MMSLAB 多媒体安全实验室</p><p class="sidebar-institution">{{ site.institution }}</p><p class="sidebar-description">多媒体安全 · 信息隐藏</p><ul class="sidebar-links"><li><span aria-hidden="true">⌖</span> 武汉，中国</li><li><a href="mailto:renyz@whu.edu.cn">✉ renyz@whu.edu.cn</a></li><li><a href="{{ '/people/ren-yanzhen/' | relative(page.url) }}">任延珍老师 ↗</a></li><li><a href="{{ '/resources/' | relative(page.url) }}">开放资源 ↗</a></li><li><a href="https://github.com/Secrethhh/lab-website">GitHub ↗</a></li></ul></aside><main id="main">{{ content | safe }}</main></div>
<footer><div><strong>MMSLAB 多媒体安全实验室</strong><p>{{ site.institution }}</p></div><div><span>资料更新：</span>{{ site.updated }}<p><a href="https://github.com/Secrethhh/lab-website">网站源码与维护说明</a></p></div></footer></body></html>
