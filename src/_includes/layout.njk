<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ description or site.intro }}"><title>{% if page.url == '/' %}MMSLAB{% else %}{{ title }} · MMSLAB{% endif %}</title><link rel="stylesheet" href="{{ '/assets/academic.css' | relative(page.url) }}?v={{ styleVersion }}"></head>
<body><a class="skip" href="#main">跳至正文</a>
<header class="masthead"><div class="masthead-inner"><a class="brand" href="{{ '/' | relative(page.url) }}">MMSLAB</a><nav aria-label="主导航">{% for label,url in [['团队简介','/'],['News','/#news'],['近期重点成果','/#publications'],['论文成果','/publications/']] %}<a {% if page.url == url or (url != '/' and url in page.url) %}aria-current="page"{% endif %} href="{% if page.url == '/' and '#' in url %}{{ url | replace('/', '') }}{% else %}{{ url | relative(page.url) }}{% endif %}">{{ label }}</a>{% endfor %}</nav><a class="language" href="{{ ('/en' + page.url) | relative(page.url) }}" lang="en" hreflang="en" aria-label="Switch to English">English ↗</a></div></header>
<script>
// Measure navigation height when its items wrap or the viewport changes.
const masthead = document.querySelector(".masthead");
const updateHeaderHeight = () => document.documentElement.style.setProperty("--masthead-height", `${masthead.getBoundingClientRect().height}px`);
updateHeaderHeight();
if (window.ResizeObserver) new ResizeObserver(updateHeaderHeight).observe(masthead);
else window.addEventListener("resize", updateHeaderHeight);
</script>
<div class="site-shell{% if page.url == '/people/ren-yanzhen/' %} profile-layout{% endif %}"><aside class="lab-sidebar"><a class="lab-emblem" href="{{ '/' | relative(page.url) }}" aria-label="MMSLAB"><img src="{{ '/assets/mmslab-logo.png' | relative(page.url) }}" alt="MMSLAB" width="336" height="249" decoding="async"></a><p class="sidebar-name">MMSLAB 多媒体安全实验室</p><p class="sidebar-institution">{{ site.institution }}</p><p class="sidebar-description">多媒体安全 · 信息隐藏</p><ul class="sidebar-links"><li><span aria-hidden="true">⌖</span> 中国，武汉</li><li><span aria-hidden="true">👤</span> 团队负责人：<a href="{{ '/people/ren-yanzhen/' | relative(page.url) }}"><strong>任延珍 教授</strong></a></li><li><a href="mailto:renyz@whu.edu.cn">✉ renyz@whu.edu.cn</a></li></ul></aside><main id="main">{{ content | safe }}</main></div>
<script>
// Keep the lab website open when following external web resources.
document.querySelectorAll('a[href]').forEach(link => {
  const url = new URL(link.getAttribute('href'), location.href);
  if ((url.protocol === 'http:' || url.protocol === 'https:') && url.origin !== location.origin) {
    link.target = '_blank';
    link.relList.add('noopener', 'noreferrer');
  }
});
</script>
<div class="horizontal-scroll-control" hidden><input type="range" min="0" max="0" value="0" step="1" aria-label="Scroll page horizontally"></div>
<script>
const horizontalControl = document.querySelector('.horizontal-scroll-control');
const horizontalSlider = horizontalControl.querySelector('input');
const desktopPointer = matchMedia('(any-hover: hover) and (any-pointer: fine)');
function updateHorizontalControl() {
  const max = Math.max(0, document.documentElement.scrollWidth - document.documentElement.clientWidth);
  horizontalControl.hidden = !desktopPointer.matches || max < 2;
  horizontalSlider.max = max;
  horizontalSlider.value = window.scrollX;
}
horizontalSlider.addEventListener('input', () => window.scrollTo({left: Number(horizontalSlider.value), top: window.scrollY, behavior: 'instant'}));
window.addEventListener('scroll', () => { horizontalSlider.value = window.scrollX; }, {passive: true});
window.addEventListener('resize', updateHorizontalControl);
desktopPointer.addEventListener('change', updateHorizontalControl);
if (window.ResizeObserver) new ResizeObserver(updateHorizontalControl).observe(document.body);
updateHorizontalControl();
</script>
</body></html>
