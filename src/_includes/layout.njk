<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ description or site.intro }}"><title>{{ title }} · MALab</title><link rel="stylesheet" href="{{ '/assets/style.css' | relative(page.url) }}"></head><body><a class="skip" href="#main">跳至正文</a><header><a class="brand" href="{{ '/' | relative(page.url) }}">MA<span>Lab</span><small>多媒体安全</small></a><nav aria-label="主导航">{% for label,url in [['首页','/'],['实验室','/about/'],['研究方向','/research/'],['研究成果','/publications/'],['开放资源','/resources/'],['任延珍','/people/ren-yanzhen/']] %}<a href="{{ url | relative(page.url) }}">{{ label }}</a>{% endfor %}</nav></header><main id="main">{{ content | safe }}</main><footer><strong>MALab 多媒体安全</strong><p>{{ site.institution }}</p><p>多媒体安全 · 信息隐藏</p><small>资料更新：{{ site.updated }} · <a href="https://github.com/Secrethhh/lab-website">网站源码与维护说明</a></small></footer></body></html>