---
layout: layout.njk
---
<section class="page narrow"><a class="eyebrow" href="{{ '/publications/' | relative(page.url) }}">← 全部论文成果</a><p class="meta">{{ year }} · {{ venue }} · <span>{{ status }}</span></p><h1>{{ title }}</h1>{% if authors %}<p class="authors">{{ authors }}</p>{% endif %}<p class="lead">{{ summary }}</p><div class="links">{% if paper %}<a class="button" href="{{ paper }}">论文原文 ↗</a>{% endif %}{% if code %}<a href="{{ code }}">开放代码 ↗</a>{% endif %}{% if data %}<a href="{{ data }}">开放数据集 ↗</a>{% endif %}</div>{% if figure %}<figure class="paper-detail-figure"><a href="{{ figure | relative(page.url) }}"><img src="{{ figure | relative(page.url) }}" alt="{{ figureAlt }}"></a></figure>{% endif %}<div class="prose" lang="en">{% if problem %}<h2>Research problem</h2><p>{{ problem }}</p><h2>Method</h2><p>{{ method }}</p><h2>Resources</h2><p>{{ resourceDescription }}</p><h2>Use cases</h2><p>{{ usage }}</p>{% else %}{{ content | safe }}{% endif %}</div><p class="source"><span>资料依据：</span><span>{{ source }}</span><span>。论文的最终版本与使用许可请以原始发布页为准。</span></p></section>