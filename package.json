{
  "name": "malab-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MALab 内容管理官网：Eleventy + Markdown + Pages CMS",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "node scripts/validate.mjs && node scripts/clean-output.mjs && eleventy",
    "check": "node scripts/check-output.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "gray-matter": "4.0.3",
    "markdown-it": "14.3.2",
    "yaml": "2.8.1"
  }
}